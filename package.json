{
	"name": "layerchart-upset",
	"version": "0.2.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && svelte-package",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run src",
		"docs:gallery": "node scripts/gallery.mjs",
		"test:interact": "node test/interact/upset.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3-scale": "^4.0.9",
		"playwright-core": "^1.64.1",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"wait-on": "^9.5.1"
	},
	"keywords": [
		"svelte"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"d3-scale": "^4.0.3",
		"layerchart": "^2.9.2"
	},
	"overrides": {
		"@sveltejs/kit": "$@sveltejs/kit"
	}
}
